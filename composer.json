{
    "name": "universally/craft-universally",
    "description": "Translate public Craft CMS pages on the server and give each language its own URL.",
    "keywords": [
        "craft-plugin",
        "translation",
        "localization",
        "multilingual",
        "language-switcher"
    ],
    "homepage": "https://universally.com/",
    "license": "proprietary",
    "type": "craft-plugin",
    "authors": [
        {
            "name": "Universally LLC",
            "homepage": "https://universally.com/"
        }
    ],
    "support": {
        "email": "support@universally.com",
        "docs": "https://github.com/wayheming/universally-craft#readme",
        "source": "https://github.com/wayheming/universally-craft"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.8",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Universally\\CraftCms\\": "src/"
        }
    },
    "extra": {
        "handle": "universally",
        "name": "Universally - AI Translation",
        "class": "Universally\\CraftCms\\Plugin",
        "documentationUrl": "https://github.com/wayheming/universally-craft#readme",
        "developer": "Universally",
        "developerUrl": "https://universally.com/",
        "developerEmail": "support@universally.com"
    }
}
